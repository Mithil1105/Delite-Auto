# Server-only Odoo credentials — read by files under server/odoo/ and api/catalog/.
# NEVER prefix these with VITE_ (that would expose them to browser code).
# NEVER commit a real .env file — this .env.example is placeholders only.
#
# Until these are set, isOdooConfigured() (server/odoo/client.ts) returns false and the
# /api/catalog/* endpoints fall back to the local mock catalog (src/data/products.ts).

ODOO_BASE_URL=https://your-instance.odoo.com
ODOO_DATABASE=your-database-name
ODOO_USERNAME=your-odoo-username
ODOO_API_KEY=your-odoo-api-key

# Optional — leave unset until confirmed. Only set these AFTER running
# GET /api/internal/odoo/schema (or the opt-in test suite) against the real instance and finding
# the actual field name. Setting one to a guessed name will make product listing/detail requests
# fail outright (Odoo errors on an unknown field), not silently misbehave — see
# server/odoo/customFieldMap.ts and Documentations MD/odoo-schema-report.md.
# ODOO_BRAND_FIELD=x_studio_brand
# ODOO_VEHICLE_FIELD=x_studio_vehicle_type
# ODOO_MRP_FIELD=x_studio_mrp

# Optional — required to reach api/internal/odoo/{health,schema} in production; in development
# they're open by default. Set to any random secret string; send it back as the `x-internal-token`
# request header. See server/odoo/internalAccessGuard.ts.
# INTERNAL_DIAGNOSTICS_TOKEN=

# Client-side, non-secret: which catalogService implementation the frontend uses.
# "mock" (default) reads src/data/products.ts directly, in-process, synchronously.
# "supabase" calls the real Odoo catalog via Supabase Edge Functions (see
# src/services/catalog/supabaseCatalogService.ts and Documentations MD/odoo-real-catalog.md) —
# the production path. Requires VITE_SUPABASE_URL/VITE_SUPABASE_PUBLISHABLE_KEY below, never Odoo
# credentials client-side.
# "http" calls the legacy /api/catalog/* Vercel routes (see httpCatalogService.ts) — kept for
# parity/rollback only, not the production path once "supabase" is verified working.
VITE_CATALOG_SOURCE=mock

# Required for VITE_CATALOG_SOURCE=supabase. Both are safe in the browser by design (the anon/
# publishable key, not a secret) — see Documentations MD/odoo-supabase-edge-functions.md.
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Odoo native checkout handoff base URL — see src/lib/odooCheckoutHandoff.ts and
# Documentations MD/odoo-native-checkout.md. The production checkout path is now "hand the cart
# off to Odoo's own native website_sale checkout" rather than our own custom checkout; this is the
# domain that handoff navigates to. Development value points at the real production Odoo site's
# test handoff page (no separate dev/staging Odoo instance exists). Becomes
# https://shop.deliteauto.com once that subdomain is configured — only this value changes.
# VITE_ODOO_CHECKOUT_BASE_URL=https://www.deliteauto.com
