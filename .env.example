# Server-only Odoo credentials — read by files under server/odoo/ and api/catalog/.
# NEVER prefix these with VITE_ (that would expose them to browser code).
# NEVER commit a real .env file — this .env.example is placeholders only.
#
# Until these are set, isOdooConfigured() (server/odoo/client.ts) returns false and the
# /api/catalog/* endpoints fall back to the local mock catalog (src/data/products.ts).

ODOO_BASE_URL=https://your-instance.odoo.com
ODOO_DATABASE=your-database-name
ODOO_USERNAME=your-odoo-username
ODOO_API_KEY=your-odoo-api-key

# Client-side, non-secret: which catalogService implementation the frontend uses.
# "mock" (default) reads src/data/products.ts directly, in-process, synchronously.
# "http" calls /api/catalog/* (see src/services/catalog/httpCatalogService.ts) — switch to this
# once the endpoints above are backed by real Odoo data and you've verified them.
VITE_CATALOG_SOURCE=mock
